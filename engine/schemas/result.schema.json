{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Money graph engine result v1",
  "type": "object",
  "required": ["schema_version", "engine_version", "nodes", "top_nodes", "meta"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "engine_version": {"type": "string"},
    "engine": {"type": "string", "description": "Legacy Python identification alias; added in engine 1.1.0"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "top_nodes": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/top_node"}},
    "meta": {
      "type": "object",
      "properties": {"resilience": {"$ref": "#/$defs/resilience"}}
    }
  },
  "$defs": {
    "gid": {"type": "string", "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)$"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "explanation": {"type": "string", "minLength": 1, "maxLength": 200},
    "role": {"enum": ["consolidator", "transit", "distributor", "terminal", "coordinator", "peripheral"]},
    "resilience_scenario": {
      "type": "object",
      "required": ["strategy", "requested_k", "removed_gids", "remaining_nodes", "remaining_edges", "weak_components", "isolated_nodes", "largest_component_nodes", "largest_component_share_remaining", "removed_edge_sum_kzt", "removed_edge_sum_share"],
      "properties": {
        "strategy": {"enum": ["baseline", "priority", "volume"]},
        "requested_k": {"type": "integer", "minimum": 0},
        "removed_gids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gid"}},
        "remaining_nodes": {"type": "integer", "minimum": 0},
        "remaining_edges": {"type": "integer", "minimum": 0},
        "weak_components": {"type": "integer", "minimum": 0},
        "isolated_nodes": {"type": "integer", "minimum": 0},
        "largest_component_nodes": {"type": "integer", "minimum": 0},
        "largest_component_share_remaining": {"$ref": "#/$defs/score"},
        "removed_edge_sum_kzt": {"type": "number", "minimum": 0},
        "removed_edge_sum_share": {"$ref": "#/$defs/score"}
      }
    },
    "resilience": {
      "description": "Added in engine 1.3.0; optional for older v1 results. Fixed-ranking structural experiment on the observed graph, not prevented losses.",
      "type": "object",
      "required": ["schema_version", "connectivity", "scope", "baseline", "scenarios"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "connectivity": {"const": "weak"},
        "scope": {"const": "observed_graph"},
        "baseline": {
          "allOf": [{"$ref": "#/$defs/resilience_scenario"}],
          "properties": {
            "strategy": {"const": "baseline"}, "requested_k": {"const": 0},
            "removed_gids": {"maxItems": 0},
            "removed_edge_sum_kzt": {"const": 0}, "removed_edge_sum_share": {"const": 0}
          }
        },
        "scenarios": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {"$ref": "#/$defs/resilience_scenario"},
          "prefixItems": [
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "priority"}, "requested_k": {"const": 1}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "priority"}, "requested_k": {"const": 3}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "priority"}, "requested_k": {"const": 5}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "priority"}, "requested_k": {"const": 10}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "volume"}, "requested_k": {"const": 1}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "volume"}, "requested_k": {"const": 3}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "volume"}, "requested_k": {"const": 5}}},
            {"$ref": "#/$defs/resilience_scenario", "properties": {"strategy": {"const": "volume"}, "requested_k": {"const": 10}}}
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["gid", "cluster_id", "role", "role_score", "priority_score", "evidence", "why", "features", "role_candidates", "priority_breakdown", "warnings"],
      "properties": {
        "gid": {"$ref": "#/$defs/gid"},
        "cluster_id": {"type": "integer", "minimum": 0},
        "role": {"$ref": "#/$defs/role"},
        "role_score": {"$ref": "#/$defs/score"},
        "priority_score": {"$ref": "#/$defs/score"},
        "evidence": {"$ref": "#/$defs/explanation"},
        "why": {"$ref": "#/$defs/explanation"},
        "features": {"type": "object"},
        "role_candidates": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["role", "score"],
          "properties": {"role": {"$ref": "#/$defs/role"}, "score": {"$ref": "#/$defs/score"}}
        }},
        "priority_breakdown": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "next_actions": {
          "description": "Added in engine 1.2.0; optional for older v1 results. Ordered suggestions for analyst verification, not automated requests.",
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": {"$ref": "#/$defs/explanation", "pattern": "\\S"}
        }
      }
    },
    "top_node": {
      "type": "object",
      "required": ["rank", "gid", "role", "priority_score", "why"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "gid": {"$ref": "#/$defs/gid"},
        "role": {"$ref": "#/$defs/role"},
        "priority_score": {"$ref": "#/$defs/score"},
        "why": {"$ref": "#/$defs/explanation"}
      }
    }
  }
}
